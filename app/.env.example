# Copy to .env.production.local (or let scripts/deploy.sh write it).
# Network: mainnet (default) or testnet
VITE_NETWORK=mainnet
# Soroban RPC endpoint. Mainnet has no SDF-hosted RPC: use your provider's URL.
VITE_RPC_URL=
# Contract ids printed by scripts/deploy.sh
VITE_CORE_ID=
VITE_MARKET_ID=
# ESCB credit asset, CODE:ISSUER
VITE_ESCB_ASSET=
# Optional: override USDC (defaults to Circle USDC for the chosen network)
# VITE_USDC_ASSET=USDC:GA5ZSEJYB37JRC5AVCIA5MOP4RHTM335X2KGX3IHOJAPP5RE34K4KZVN
# Optional: base path when hosted under a sub-path (GitHub Pages project site)
# VITE_BASE=/escomblock/
